# Copy to /etc/vibe-vscode/service.env and replace every placeholder.
# This file is shared by the VS Code unit and the Caddy unit's EnvironmentFile.

VIBE_VSCODE_INSTALL_ROOT=<absolute-install-root>
VIBE_VSCODE_SERVICE_STATE_ROOT=<absolute-state-root>
VIBE_VSCODE_CONNECTION_TOKEN_FILE=<absolute-connection-token-file>
VIBE_VSCODE_PUBLIC_PORT=18080
VIBE_VSCODE_BACKEND_ADDRESS=unix//run/vibe-vscode/backend.sock
VIBE_VSCODE_TLS_CERT_PATH=<absolute-certificate-file>
VIBE_VSCODE_TLS_KEY_PATH=<absolute-private-key-file>
