{
	admin off
	auto_https disable_redirects
}

:{$VIBE_VSCODE_PUBLIC_PORT} {
	bind 0.0.0.0
	tls {$VIBE_VSCODE_TLS_CERT_PATH} {$VIBE_VSCODE_TLS_KEY_PATH}
	encode zstd gzip

	@authentication path {$VIBE_VSCODE_AUTH_PATH} {$VIBE_VSCODE_AUTH_PATH}/*
	handle @authentication {
		reverse_proxy {$VIBE_VSCODE_AUTH_ADDRESS} {
			header_up X-Original-Host {http.request.header.X-Forwarded-Host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		route {
			# The auth check may renew Better Auth's sliding session. Carry its cookie to the
			# browser without accepting a client-supplied renewal header.
			request_header -X-Vibe-Auth-Set-Cookie
			forward_auth {$VIBE_VSCODE_AUTH_ADDRESS} {
				uri {$VIBE_VSCODE_AUTH_PATH}/verify
				header_up X-Original-Host {http.request.header.X-Forwarded-Host}
				copy_headers Set-Cookie>X-Vibe-Auth-Set-Cookie
			}
			@renewedSession header X-Vibe-Auth-Set-Cookie *
			header @renewedSession +Set-Cookie {http.request.header.X-Vibe-Auth-Set-Cookie}

			reverse_proxy {$VIBE_VSCODE_BACKEND_ADDRESS} {
				header_up X-Original-Host {http.request.header.X-Forwarded-Host}
				header_up X-Forwarded-Proto https
				header_up -X-Vibe-Auth-Set-Cookie
			}
		}
	}
}
