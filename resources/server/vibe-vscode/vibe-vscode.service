[Unit]
Description=Vibe VS Code Web Server
After=network.target

[Service]
Type=simple
User=vibe-vscode
Group=vibe-vscode
EnvironmentFile=/etc/vibe-vscode/service.env
RuntimeDirectory=vibe-vscode
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/env ${VIBE_VSCODE_INSTALL_ROOT}/current/bin/vibe-vscode-server --socket-path /run/vibe-vscode/backend.sock --server-data-dir ${VIBE_VSCODE_SERVICE_STATE_ROOT}/server --extensions-dir ${VIBE_VSCODE_SERVICE_STATE_ROOT}/extensions --auth-state-dir ${VIBE_VSCODE_SERVICE_STATE_ROOT}/auth --public-origin ${VIBE_VSCODE_PUBLIC_ORIGIN} --auth-session-ttl-seconds ${VIBE_VSCODE_AUTH_SESSION_TTL_SECONDS} --without-connection-token --accept-server-license-terms
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
