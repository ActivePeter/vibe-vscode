{
	admin off
	auto_https disable_redirects
}

:{$VIBE_VSCODE_PUBLIC_PORT} {
	bind 0.0.0.0
	tls {$VIBE_VSCODE_TLS_CERT_PATH} {$VIBE_VSCODE_TLS_KEY_PATH}
	encode zstd gzip
	# Headers only select from the server's explicit origin allowlist.
	map {http.request.header.X-Forwarded-Host} {vibe_public_host} {
		"" {http.request.hostport}
		default {http.request.header.X-Forwarded-Host}
	}

	@authentication path {$VIBE_VSCODE_AUTH_PATH} {$VIBE_VSCODE_AUTH_PATH}/*
	handle @authentication {
		reverse_proxy {$VIBE_VSCODE_AUTH_ADDRESS} {
			# Authentication routes are HTTP-only, never a VS Code upgrade entry point.
			header_up -Connection
			header_up -Upgrade
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {vibe_public_host}
		}
	}

	handle {
		route {
			# Successful verification renews at most one session_token (cookieCache is off).
			# The server enforces this; denials bypass the bridge and may clear multiple cookies.
			request_header -X-Vibe-Auth-Set-Cookie
			forward_auth {$VIBE_VSCODE_AUTH_ADDRESS} {
				uri {$VIBE_VSCODE_AUTH_PATH}/verify
				# The authorization subrequest must reach the HTTP handler, not Node's
				# upgrade event. Preserve only the original request kind for 401 vs 303.
				header_up X-Forwarded-Upgrade {http.request.header.Upgrade}
				header_up -Connection
				header_up -Upgrade
				header_up X-Forwarded-Host {vibe_public_host}
				copy_headers Set-Cookie>X-Vibe-Auth-Set-Cookie
			}
			@renewedSession header X-Vibe-Auth-Set-Cookie *
			header @renewedSession +Set-Cookie {http.request.header.X-Vibe-Auth-Set-Cookie}

			reverse_proxy {$VIBE_VSCODE_BACKEND_ADDRESS} {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {vibe_public_host}
				header_up -X-Vibe-Auth-Set-Cookie
			}
		}
	}
}
